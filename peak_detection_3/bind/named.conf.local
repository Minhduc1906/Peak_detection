//
// Do any local configuration here
//

// Consider adding the 1918 zones here, if they are not used in your
// organization
//include "/etc/bind/zones.rfc1918";

zone "mgmt.net" {
	type master;
	file "/etc/bind/db.mgmt.net";
};

zone "home.net" {
	type master;
	file "/etc/bind/db.home.net";
};

zone "nbn.net" {
	type master;
	file "/etc/bind/db.nbn.net";
};

zone "rsp.net" {
	type master;
	file "/etc/bind/db.rsp.net";
};

zone "cdn.net" {
	type master;
	file "/etc/bind/db.cdn.net";
};

zone "10.10.10.in-addr.arpa" {
	type master;
	file "/etc/bind/db.10.10.10";
};

zone "100.168.192.in-addr.arpa" {
	type master;
	file "/etc/bind/db.192.168.100";
};

zone "1.16.172.in-addr.arpa" {
	type master;
	file "/etc/bind/db.172.16.1";
};

zone "1.20.172.in-addr.arpa" {
	type master;
	file "/etc/bind/db.172.20.1";
};

zone "1.1.10.in-addr.arpa" {
	type master;
	file "/etc/bind/db.10.1.1";
};
