;
; BIND data file for local loopback interface
;
$TTL	604800
@	IN	SOA	localhost. root.localhost. (
		     2024083001		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
@	IN	NS	localhost.

$ORIGIN nbn.net.

cust-rsp	A	10.1.1.1
r1		CNAME	cust-rsp
rsp-cust	A	10.1.1.2
r2		CNAME	rsp-cust
