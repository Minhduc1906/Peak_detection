;
; BIND data file for local loopback interface
;
$TTL	604800
@	IN	SOA	localhost. root.localhost. (
		     2024083001		; Serial
			 604800		; Refresh
			  86400		; Retry
			2419200		; Expire
			 604800 )	; Negative Cache TTL
;
@	IN	NS	localhost.

$ORIGIN rsp.net.
rsp-int-cust	A	172.16.1.1
rsp-ext		A	172.16.1.254
